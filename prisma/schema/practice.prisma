// One "diagnose → teach → practice" pass, scoped to one known skillId.
model LearningSession {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String    @db.ObjectId
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  rawInput  String? // optional free-text detail
  diagnosis Json? // validated AI diagnosis output
  status    String    @default("diagnosing") // diagnosing|teaching|practicing|completed
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([userId, skillId])
}

model PracticeSession {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  userId            String         @db.ObjectId
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId           String         @db.ObjectId // the selected node (a sub-skill, or a parent for "mixed" later)
  skill             Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  status            PracticeStatus @default(IN_PROGRESS)
  totalQuestions    Int
  answeredCount     Int            @default(0)
  correctCount      Int            @default(0)
  generationContext Json? // the weakness summary fed to the AI, useful for debugging
  startedAt         DateTime       @default(now())
  completedAt       DateTime?

  exercises Exercise[]
  attempts  ExerciseAttempt[]

  @@index([userId, status])
  @@index([userId, skillId])
}

model Exercise {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  sessionId      String           @db.ObjectId
  session        PracticeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skillId        String           @db.ObjectId // the actual sub-skill this question tests
  skill          Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  order          Int
  difficulty     Difficulty
  prompt         String
  options        String[]
  correctAnswer  String
  explanation    String
  attempt        ExerciseAttempt?
  questionBank   QuestionBank?    @relation(fields: [questionBankId], references: [id])
  questionBankId String?          @db.ObjectId

  @@unique([sessionId, order])
}

model ExerciseAttempt {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  userId      String          @db.ObjectId
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String          @db.ObjectId
  session     PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId  String          @unique @db.ObjectId // one attempt per question
  exercise    Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  skillId     String          @db.ObjectId // denormalized on purpose
  userAnswer  String
  isCorrect   Boolean
  timeSpentMs Int?
  createdAt   DateTime        @default(now())

  @@index([userId, skillId])
}

model SkillProgress {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String    @db.ObjectId
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  masteryScore    Float     @default(0)
  correctCount    Int       @default(0)
  incorrectCount  Int       @default(0)
  lastPracticedAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, skillId])
}

enum PracticeStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}


enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
