// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  firstName          String
  lastName           String
  email              String             @unique
  password           String?
  role               Role               @default(USER)
  isSuspended        Boolean            @default(false)
  profileImage       String?
  bio                String?
  phoneNumber        String?
  country            String?
  timezone           String?
  registrationMethod RegistrationMethod @default(EMAIL)
  googleId           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  profile        LearningProfile?
  sessions       LearningSession[]
  attempts       ExerciseAttempt[]
  submissions    SentenceSubmission[]
  skillProgress  SkillProgress[]
  weaknesses     Weakness[]
  reviews        ReviewSchedule[]
  testAttempts   TestAttempt[]
  myVocabularies MyVocabulary[]
  vocabStories   VocabStory[]
}

// The curated taxonomy — seeded by you, not created by the AI at runtime.
model Skill {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  slug      String        @unique // "present_perfect"
  name      String // "Present Perfect"
  category  String // "verb_tenses"
  cefr      EnglishLevel? // "B1"
  parentId  String?       @db.ObjectId
  parent    Skill?        @relation("SkillTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Skill[]       @relation("SkillTree")
  createdAt DateTime?     @default(now())
  updatedAt DateTime?     @updatedAt

  sessions    LearningSession[]
  exercises   Exercise[]
  submissions SentenceSubmission[]
  progress    SkillProgress[]
  weaknesses  Weakness[]
  reviews     ReviewSchedule[]
}

// One "diagnose → teach → practice" pass, scoped to one known skillId.
model LearningSession {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String     @db.ObjectId
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  rawInput  String? // optional free-text detail
  diagnosis Json? // validated AI diagnosis output
  status    String     @default("diagnosing") // diagnosing|teaching|practicing|completed
  createdAt DateTime?  @default(now())
  updatedAt DateTime?  @updatedAt
  exercises Exercise[]
}

model Exercise {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  sessionId  String            @db.ObjectId
  session    LearningSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skillId    String            @db.ObjectId
  skill      Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  type       String // mcq|fill_blank|error_correction|sentence_transform
  difficulty String // beginner|intermediate|advanced
  content    Json // question/options — AI-generated, backend-validated
  createdAt  DateTime?         @default(now())
  updatedAt  DateTime?         @updatedAt
  attempts   ExerciseAttempt[]
}

model ExerciseAttempt {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String    @db.ObjectId
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userAnswer String
  isCorrect  Boolean
  createdAt  DateTime? @default(now())
}

model SentenceSubmission {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @db.ObjectId
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId           String    @db.ObjectId
  skill             Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  prompt            String
  sentence          String
  aiEvaluation      Json // errors, correction, explanation
  usedTargetGrammar Boolean
  createdAt         DateTime? @default(now())
}

model Weakness {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId       String    @db.ObjectId
  skill         Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  confidence    Float // 0–1, backend-calculated from evidence
  evidenceCount Int       @default(0)
  status        String    @default("active") // active|improving|resolved
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt

  @@unique([userId, skillId])
}

model SkillProgress {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String    @db.ObjectId
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  masteryScore    Float     @default(0) // 0–100, backend-owned math
  correctCount    Int       @default(0)
  incorrectCount  Int       @default(0)
  lastPracticedAt DateTime?
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt

  @@unique([userId, skillId])
}

model ReviewSchedule {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId      String    @db.ObjectId
  skill        Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  nextReviewAt DateTime
  intervalDays Int       @default(1)
  lastResult   String? // success|fail
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt

  @@unique([userId, skillId])
}

model LearningProfile {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @unique @db.ObjectId
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  estimatedCEFR    EnglishLevel  @default(A2)
  targetLevel      EnglishLevel?
  nativeLanguage   String?
  learningGoals    String[]      @default([])
  dailyGoalMinutes Int?          @default(15)
  streakDays       Int           @default(0)
  longestStreak    Int           @default(0)
  lastActiveAt     DateTime?
  createdAt        DateTime?     @default(now())
  updatedAt        DateTime?     @updatedAt
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model LevelTestSet {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  name        String              @unique
  description String?
  isActive    Boolean             @default(true)
  questions   LevelTestQuestion[]
  attempts    TestAttempt[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model LevelTestQuestion {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  setId              String?             @db.ObjectId
  set                LevelTestSet?       @relation(fields: [setId], references: [id], onDelete: SetNull)
  question           String
  passage            String?
  sectionType        TestQuestionSection
  level              EnglishLevel
  difficulty         DifficultyType
  questionOptions    QuestionOption[]
  answer             String?
  explanation        String?
  testAttemptAnswers TestAttemptAnswer[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model QuestionOption {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  content    String
  isCorrect  Boolean           @default(false)
  questionId String            @db.ObjectId
  question   LevelTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
}

model TestAttempt {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  userId           String              @db.ObjectId
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId            String?             @db.ObjectId
  set              LevelTestSet?       @relation(fields: [setId], references: [id], onDelete: SetNull)
  score            Int
  totalQuestions   Int?                @default(0)
  percentage       Float?              @default(0)
  timeSpentSeconds Int?                @default(0)
  duration         String?
  sectionBreakdown Json?
  answers          TestAttemptAnswer[]
  estimatedLevel   EnglishLevel
  aiAnalysis       Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model TestAttemptAnswer {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  questionId String            @db.ObjectId
  question   LevelTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptId  String            @db.ObjectId
  attempt    TestAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  userAnswer String
  isCorrect  Boolean
  createdAt  DateTime          @default(now())

  @@unique([attemptId, questionId])
}

model Vocabulary {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  word             String         @unique
  meaning          String
  banglaMeaning    String
  partOfSpeech     PartOfSpeech
  collocations     String[]
  exampleSentences String[]
  wordFamily       Json?
  synonyms         Json?
  antonyms         Json?
  englishLevel     EnglishLevel
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  myVocabularies   MyVocabulary[]
}

model MyVocabulary {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  userId           String           @db.ObjectId
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId           String           @db.ObjectId
  word             Vocabulary       @relation(fields: [wordId], references: [id], onDelete: Cascade)
  mySentences      String[]
  notes            String?
  masteryLevel     Int              @default(0)
  vocabularyStatus VocabularyStatus
  isFavourate      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, wordId])
}

model VocabStory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?  @default("Vocabulary Story")
  storyEnglish   String
  storyBangla    String
  usedVocabulary String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum TestQuestionSection {
  GRAMMAR
  VOCABULARY
  READING
}

enum EnglishLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum DifficultyType {
  EASY
  MEDIUM
  HARD
}

enum RegistrationMethod {
  EMAIL
  GOOGLE
}

enum PartOfSpeech {
  NOUN
  PRONOUN
  VERB
  ADJECTIVE
  ADVERB
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  NUMERAL
  PARTICLE
}

enum VocabularyStatus {
  LEARNING
  LEARNED
  MASTERED
}
